+    @classmethod
+    async def dog_claim_event(cls, event) -> bool:
+        event_id = int(event.get_id())
+        for attempt in range(5):
+            try:
+                cursor = GDO_Event.table().delete_query().where(f"event_id={event_id}").exec()
+                return getattr(cursor, 'rowcount', None) == 1  # 0 = claimed by someone else, -1/None = unknown: don't run
+            except Exception as ex:
+                if attempt == 4:
+                    Logger.exception(ex, f"IPC to_dog claim of event {event_id} failed, retry next tick")
+                    return False
+                await asyncio.sleep(0.05 * (attempt + 1))
